  "texts": [
   {
    "t0": 0.3,
    "t1": 2.0,
    "ar": [
     "الفَتْرَةُ هَذه كَأَنَّ رَبِّي يَقُولُ لي"
    ],
    "en": [
     "This period feels like my Lord is telling me"
    ]
   },
   {
    "t0": 2.3,
    "t1": 3.8,
    "ar": [
     "وَضَعْتُكَ في كُلِّ المَوَاقِف"
    ],
    "en": [
     "I put you through every situation"
    ]
   },
   {
    "t0": 4.0,
    "t1": 5.4,
    "ar": [
     "لِأُرِيَكَ حَقِيقَةَ النَّاس"
    ],
    "en": [
     "To show you the truth about people"
    ]
   },
   {
    "t0": 6.0,
    "t1": 7.2,
    "ar": [
     "وَأُعَلِّمَكَ كَيْفَ تَصْبِر"
    ],
    "en": [
     "And teach you how to be patient"
    ]
   },
   {
    "t0": 7.4,
    "t1": 8.5,
    "ar": [
     "وَكَيْفَ تَتَجَاوَز"
    ],
    "en": [
     "And how to overcome"
    ]
   },
   {
    "t0": 8.9,
    "t1": 10.4,
    "ar": [
     "وَكَيْفَ لا تَتَعَلَّقُ إلّا بي"
    ],
    "en": [
     "And to rely only on Me"
    ]
   },
   {
    "t0": 10.9,
    "t1": 11.8,
    "ar": [
     "كُلُّ مَوْقِفٍ أتْعَبَك"
    ],
    "en": [
     "Every situation that hurt you"
    ]
   },
   {
    "t0": 12.0,
    "t1": 13.7,
    "ar": [
     "كَانَ يَبْنِي فيكَ شَيْئًا جَدِيد"
    ],
    "en": [
     "It was building something new in you"
    ]
   },
   {
    "t0": 14.0,
    "t1": 16.0,
    "ar": [
     "وَكُلُّ خِذْلانٍ كَانَ يُعَلِّمُكَ دَرْسًا"
    ],
    "en": [
     "Every disappointment taught you a lesson"
    ]
   },
   {
    "t0": 16.4,
    "t1": 18.3,
    "ar": [
     "وَكُلُّ ضِيقٍ كَانَ يُقَرِّبُكَ مِنّي"
    ],
    "en": [
     "Every hardship brought you closer to Me"
    ]
   },
   {
    "t0": 18.8,
    "t1": 20.2,
    "ar": [
     "حَتَّى تَفْهَمَ أنَّ ما مَرَرْتَ به"
    ],
    "en": [
     "So you understand what you went through"
    ]
   },
   {
    "t0": 20.4,
    "t1": 21.6,
    "ar": [
     "لَمْ يَكُنْ لِيَكْسِرَك"
    ],
    "en": [
     "It wasn't meant to break you"
    ]
   },
   {
    "t0": 21.9,
    "t1": 24.0,
    "ar": [
     "بَلْ لِيُقَوِّيَكَ وَيُجَهِّزَكَ لِمَا هُوَ أَجْمَل"
    ],
    "en": [
     "To make you stronger for better days"
    ]
   }
  ]
 },
