{
  "_source": "OSM Brand Guidelines v1.0 (Oct 2026). Status tags copied from the book: VERIFIED / SAMPLED / PROPOSED / OBSERVED / APPROX.",
  "color": {
    "night":         { "hex": "#0A0F16", "role": "Primary background", "status": "VERIFIED" },
    "surface":       { "hex": "#141B26", "role": "Cards, panels", "status": "SAMPLED" },
    "surfaceRaised": { "hex": "#1C2634", "role": "Raised cards", "status": "PROPOSED" },
    "line":          { "hex": "#263244", "role": "1px borders, dividers", "status": "PROPOSED" },
    "deepNavy":      { "hex": "#12203C", "role": "Feature bands", "status": "SAMPLED" },
    "coreBlue":      { "hex": "#56A0FB", "role": "Action / progress / the ONE highlighted keyword", "status": "VERIFIED" },
    "glowBlue":      { "hex": "#77B7FB", "role": "Gradients, glow (one per screen)", "status": "VERIFIED" },
    "signalCyan":    { "hex": "#7DD2EC", "role": "Eyebrow labels only", "status": "SAMPLED" },
    "textWhite":     { "hex": "#E5EBF1", "role": "Primary text", "status": "VERIFIED" },
    "muted":         { "hex": "#8C98AA", "role": "Secondary text, captions", "status": "APPROX" },
    "methodCopper":  { "hex": "#C9935F", "role": "EARNED only: points, streaks, rewards, winners, PRs", "status": "SAMPLED" },
    "steel":         { "hex": "#7F8EA3", "role": "Logo tagline, quiet graphics", "status": "SAMPLED" },
    "success":       { "hex": "#6FD58A", "role": "Status: accepted/complete (+ word or icon)", "status": "SAMPLED" },
    "warning":       { "hex": "#F2B84B", "role": "Status: pending", "status": "PROPOSED" },
    "error":         { "hex": "#F26D6D", "role": "Status: rejected / 'Not OSM' examples", "status": "PROPOSED" }
  },
  "contrast": {
    "textOnCoreBlue": "night (#0A0F16) only — white on Core Blue fails (2.7:1)"
  },
  "font": {
    "latin":   { "family": "Inter", "files": ["fonts/Inter[opsz,wght].ttf", "fonts/Inter-Italic[opsz,wght].ttf"], "titles": "Black 900 Italic, CAPS, tracking -2%" },
    "numbers": { "family": "Barlow Condensed", "files": ["fonts/BarlowCondensed-SemiBold.ttf", "fonts/BarlowCondensed-Bold.ttf"], "use": "Stats, counters, points only" },
    "arabic":  { "family": "IBM Plex Sans Arabic", "files": ["fonts/IBMPlexSansArabic-Regular.ttf", "fonts/IBMPlexSansArabic-Medium.ttf", "fonts/IBMPlexSansArabic-SemiBold.ttf", "fonts/IBMPlexSansArabic-Bold.ttf"], "rules": "Never italic, never letter-spaced, +1–2px vs Latin, line-height 1.7, Western digits" }
  },
  "typeScale1080": {
    "_note": "Book scale is for a ~390pt-wide screen; multiply by ~2.77 for a 1080px-wide video frame. Values below are the converted starting points.",
    "display":   { "size": 176, "lineHeight": 0.95, "tracking": "-2%", "font": "Inter Black Italic caps" },
    "h1":        { "size": 110, "lineHeight": 1.0,  "tracking": "-2%", "font": "Inter Black Italic caps" },
    "h2":        { "size": 78,  "lineHeight": 1.15, "font": "Inter ExtraBold" },
    "body":      { "size": 44,  "lineHeight": 1.55, "font": "Inter Regular" },
    "caption":   { "size": 36,  "lineHeight": 1.45, "font": "Inter Regular, Muted" },
    "eyebrow":   { "size": 30,  "tracking": "+22%", "font": "Inter Bold caps, Signal Cyan" },
    "stat":      { "size": 132, "font": "Barlow Condensed Bold" }
  },
  "layout": {
    "grid": 8,
    "cardRadius": [16, 20],
    "border": "1px line",
    "titleBar": "short Core Blue bar under titles (~60x5 at book scale)",
    "texture": "diagonal hairlines at 112°, 3–5% white",
    "reelSafeTopBottom": "14% of frame height (≈269px at 1920) — no text there",
    "logoClearSpace": "X = half the height of the 'O' in OSM, all sides"
  },
  "logo": {
    "emblem":   { "file": "logo/osm-emblem-1254.jpg", "use": "Hero art only, large, dark backgrounds", "minWidthPx": 240 },
    "wordmark": { "file": "logo/osm-wordmark-780x264.jpg", "use": "Everyday logo: end cards, corner bug", "minWidthPx": 120, "status": "RASTER CROP · TEMPORARY — black box baked in, dark backgrounds only" }
  }
}
